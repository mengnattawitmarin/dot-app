{
  "name": "dot-app",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Do.T — Radio · TV · Entertainment for Android & iPhone (Capacitor)",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "native:add": "cap add android && cap add ios && node scripts/patch-native.mjs",
    "native:patch": "node scripts/patch-native.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0b0a08' --splashBackgroundColor '#0b0a08'",
    "check:streams": "node --experimental-strip-types scripts/check-streams.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.2.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.2.0",
    "@capacitor/ios": "^7.2.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "hls.js": "^1.5.20",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.2.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
